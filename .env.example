# For more information, please see the README.md
SUNO_COOKIE=
YESCAPTCHA_KEY=
BROWSER_HEADLESS=true
BROWSER_LOCALE=en
BROWSER_USER_AGENT=
BROWSER_CHROMIUM_VERSION=148.0.7778.96
FEISHU_BOT_WEBHOOK=
FEISHU_BOT_SECRET=
FEISHU_APP_ID=
FEISHU_APP_SECRET=
# Optional HTTP endpoint that forwards manual-captcha alerts as SMS.
SUNO_CAPTCHA_SMS_WEBHOOK_URL=
SUNO_CAPTCHA_SMS_TO=
SUNO_CAPTCHA_SMS_CODE=999999
SUNO_CAPTCHA_SMS_PYTHON=/root/Aunera/backend/.venv/bin/python
SUNO_CAPTCHA_SMS_ENV_FILE=/root/Aunera/backend/.env
SUNO_CAPTCHA_COOLDOWN_SECONDS=1800
# Wait for the local real browser recovery event after a captcha rejection.
SUNO_CAPTCHA_AUTO_RECOVER=true
# Keep server-side captcha solver disabled; never use automated challenge solving.
SUNO_SERVER_BROWSER_SOLVER=false
# Optional per-account persistent browser profiles for headed recovery.
SUNO_LOCAL_BROWSER_HANDLE=craftyonehitwonder742
# Recovery is performed in the local desktop browser. The API secret stays on the server.
SUNO_LOCAL_RECOVERY_SECRET_FILE=/root/suno-api/data/local-recovery-secret
SUNO_BROWSER_RECOVERY_TIMEOUT_MS=65000
SUNO_CAPTCHA_MAX_CONCURRENT=2
SUNO_GENERATION_MIN_INTERVAL_MS=15000
SUNO_429_MAX_RETRIES=3
SUNO_429_BASE_DELAY_MS=2000
SUNO_429_MAX_DELAY_MS=20000
SUNO_STATUS_CACHE_TTL_MS=10000
SUNO_STATUS_MIN_INTERVAL_MS=2500
SUNO_AUTH_REFRESH_INTERVAL_MINUTES=120
SUNO_AUDIO_PROXY_BASE_URL=https://your-suno-api.example.com
# Prefer direct API; explicit captcha rejection falls back to server headed Chromium for simple v6 text generations.
SUNO_GENERATION_TRANSPORT=api
SUNO_SERVER_BROWSER_FALLBACK=true
